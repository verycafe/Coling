#!/bin/zsh
set -u

script_path="${0:A}"
script_dir="${script_path:h}"
root_dir="${script_dir:h}"
command_name="${1:-turn-ended}"

require_python() {
  if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    print -u2 "codex-turn-sound: Python 3.11 or newer is required"
    exit 1
  fi
}

case "$command_name" in
  install)
    shift
    require_python
    exec python3 "$root_dir/scripts/install.py" "$@"
    ;;
  uninstall)
    shift
    require_python
    exec python3 "$root_dir/scripts/uninstall.py" "$@"
    ;;
  doctor|status)
    shift
    require_python
    exec python3 "$root_dir/scripts/doctor.py" "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
codex-turn-sound

Usage:
  codex-turn-sound install [--config PATH] [--sound PATH] [--reset-sound]
  codex-turn-sound uninstall [--config PATH]
  codex-turn-sound doctor [--json] [--play]
  codex-turn-sound turn-ended [CODEX_JSON_PAYLOAD]

Environment:
  CODEX_TURN_SOUND=Glass                     Use a macOS system sound.
  CODEX_TURN_SOUND=/absolute/path/file.wav   Use a custom audio file.
  CODEX_TURN_SOUND=off                       Disable playback for this run.
EOF
    exit 0
    ;;
esac

require_python
exec python3 "$root_dir/scripts/notify_runtime.py" "$@"
