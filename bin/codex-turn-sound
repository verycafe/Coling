#!/bin/zsh
set -u

script_path="${0:A}"
script_dir="${script_path:h}"
root_dir="${script_dir:h}"
state_dir="${CODEX_TURN_SOUND_STATE_DIR:-$HOME/.codex/codex-turn-sound}"
state_file="$state_dir/original-notify.zsh"

command_name="${1:-turn-ended}"

case "$command_name" in
  install)
    shift
    exec python3 "$root_dir/scripts/install.py" "$@"
    ;;
  uninstall)
    shift
    exec python3 "$root_dir/scripts/uninstall.py" "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
codex-turn-sound

Usage:
  codex-turn-sound install [--config PATH] [--sound PATH]
  codex-turn-sound uninstall [--config PATH]
  codex-turn-sound turn-ended

Environment:
  CODEX_TURN_SOUND=Glass                     Use a macOS system sound.
  CODEX_TURN_SOUND=/absolute/path/file.wav   Use a custom audio file.
  CODEX_TURN_SOUND=off                       Disable playback for this run.
EOF
    exit 0
    ;;
esac

typeset -ga ORIGINAL_NOTIFY
ORIGINAL_NOTIFY=()
TURN_SOUND_PATH="$root_dir/assets/soft-chime.wav"

if [[ -r "$state_file" ]]; then
  source "$state_file"
fi

event="$command_name"

if (( ${#ORIGINAL_NOTIFY[@]} > 0 )) && [[ -x "${ORIGINAL_NOTIFY[1]}" ]]; then
  "${ORIGINAL_NOTIFY[@]}" >/dev/null 2>&1 || true
fi

if [[ "$event" != "turn-ended" ]]; then
  exit 0
fi

sound="${CODEX_TURN_SOUND:-$TURN_SOUND_PATH}"

if [[ "$sound" == "off" ]]; then
  exit 0
fi

if [[ "$sound" != /* && "$sound" != *"/"* && "$sound" != *"."* ]]; then
  system_sound="/System/Library/Sounds/${sound}.aiff"
  if [[ -f "$system_sound" ]]; then
    sound="$system_sound"
  fi
fi

if [[ ! -f "$sound" ]]; then
  sound="/System/Library/Sounds/Glass.aiff"
fi

if [[ -f "$sound" && -x "/usr/bin/afplay" ]]; then
  /usr/bin/afplay "$sound" >/dev/null 2>&1 &!
fi

exit 0
